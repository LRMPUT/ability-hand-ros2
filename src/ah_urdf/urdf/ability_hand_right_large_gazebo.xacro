<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ability_hand_right_large_gazebo">


      <!-- initial position for simulations -->
  <xacro:arg name="initial_positions_file"
    default="$(find ah_urdf)/config/initial_positions.yaml" />

  <!-- convert to property to use substitution in function -->
  <xacro:property name="initial_positions_file" default="$(arg initial_positions_file)" />

  <xacro:macro name="ability_hand_right_large_ros2_control" params="prefix:='' sim_gz:='false'">

    <xacro:if value="${sim_gz}">
      <ros2_control name="${prefix}AbilityHandGazeboSim" type="system">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <joint name="${prefix}index_q1">
          <command_interface name="position">
            <param name="min">0.0</param>
            <param name="max">2.0</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">${xacro.load_yaml(initial_positions_file)['index_q1']}</param>
          </state_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>

        <joint name="${prefix}middle_q1">
          <command_interface name="position">
            <param name="min">0.0</param>
            <param name="max">2.0</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">${xacro.load_yaml(initial_positions_file)['middle_q1']}</param>
          </state_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>

        <joint name="${prefix}ring_q1">
          <command_interface name="position">
            <param name="min">0.0</param>
            <param name="max">2.0</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">${xacro.load_yaml(initial_positions_file)['ring_q1']}</param>
          </state_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>

        <joint name="${prefix}pinky_q1">
          <command_interface name="position">
            <param name="min">0.0</param>
            <param name="max">2.0</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">${xacro.load_yaml(initial_positions_file)['pinky_q1']}</param>
          </state_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>

        <joint name="${prefix}thumb_q1">
          <command_interface name="position">
            <param name="min">-2.0</param>
            <param name="max">0.0</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">${xacro.load_yaml(initial_positions_file)['thumb_q1']}</param>
          </state_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>

        <joint name="${prefix}thumb_q2">
          <command_interface name="position">
            <param name="min">0.0</param>
            <param name="max">2.0</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">${xacro.load_yaml(initial_positions_file)['thumb_q2']}</param>
          </state_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>

        <joint name="${prefix}index_q2">
          <param name="mimic">${prefix}index_q1</param>
          <param name="multiplier">0.814</param>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>

        <joint name="${prefix}middle_q2">
          <param name="mimic">${prefix}middle_q1</param>
          <param name="multiplier">0.814</param>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>

        <joint name="${prefix}ring_q2">
          <param name="mimic">${prefix}ring_q1</param>
          <param name="multiplier">0.814</param>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>

        <joint name="${prefix}pinky_q2">
          <param name="mimic">${prefix}pinky_q1</param>
          <param name="multiplier">0.814</param>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>
      </ros2_control>
    </xacro:if>

  </xacro:macro>

</robot>
