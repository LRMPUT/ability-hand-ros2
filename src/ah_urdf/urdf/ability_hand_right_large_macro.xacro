<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ability_hand_macro">

   <xacro:include filename="$(find ah_urdf)/urdf/ability_hand_right_large_gazebo.xacro"/>

   <xacro:macro name="ability_hand_right_large" params="prefix:='' parent:='base_link' sim_gz:='false' *origin">
